[Unit]
Description=Monitor video backend
After=network-online.target
Wants=network-online.target
[Service]
User=monitor
Group=monitor
WorkingDirectory=/srv/apps/monitor/current/server
EnvironmentFile=/etc/monitor.env
ExecStart=/opt/node-v24.22.2-linux-x64/bin/node src/index.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/apps/monitor/shared
UMask=0027
[Install]
WantedBy=multi-user.target
