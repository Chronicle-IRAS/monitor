# 该文件仅作为环境变量参考；服务本身不加载 .env，
# 请通过 systemd EnvironmentFile、docker run -e 或 export 注入。

# 管理 API
PORT=3000
HOST=0.0.0.0

# 视频流监听地址（每个节点占一个端口）
STREAM_HOST=0.0.0.0

# ffmpeg 可执行文件；建议写绝对路径
FFMPEG_PATH=ffmpeg

# 录像池与分段
RECORD_DIR=/var/lib/monitor-pro/records
DATA_DIR=/var/lib/monitor-pro/data
RECORD_POOL_MB=3072
SEGMENT_SECONDS=300

# 仪表盘“服务器根磁盘”统计的分区，默认 /（Windows 默认为当前盘符根目录）
DISK_PATH=/

# 允许的端口范围（需与前端表单区间一致）
UDP_PORT_MIN=9001
UDP_PORT_MAX=9050
HTTP_PORT_MIN=9051
HTTP_PORT_MAX=9100

# JPEG/UDP 硬件协议接收（CAM-WEB ESP32-S3 自定义分片）
# socket 绑定地址；默认 0.0.0.0，需要接收公网/内网硬件时保持默认
UDP_BIND_HOST=0.0.0.0
# 单帧重组超时；超时后残缺帧丢弃，下一帧重新同步
JPEG_FRAME_TIMEOUT_MS=2000
# 来源（IP:端口）无包多久后释放重组内存
JPEG_SOURCE_IDLE_MS=30000
# 单帧 JPEG 上限，防御异常偏移/伪造数据报
JPEG_MAX_FRAME_BYTES=1048576
# 无帧时按需关闭录制 ffmpeg 的空闲阈值
JPEG_RECORD_IDLE_MS=30000
# JPEG 录制转码 H.264 的输出帧率
JPEG_RECORD_FPS=15

# 跨域白名单；生产可设为 https://your.domain
CORS_ORIGIN=*

# 可选管理员令牌。留空表示后端不校验（默认，兼容现有前端）。
# Production requires ADMIN_TOKEN. Browser uses HttpOnly session; scripts use X-Admin-Token.
ADMIN_TOKEN=

LOG_LEVEL=info
