# 该文件仅作为环境变量参考；服务本身不加载 .env，
# 请通过 systemd EnvironmentFile、docker run -e 或 export 注入。

# 管理 API
PORT=3000
HOST=0.0.0.0

# 视频流监听地址（每个节点占一个端口）
STREAM_HOST=0.0.0.0

# ffmpeg 可执行文件；建议写绝对路径
FFMPEG_PATH=ffmpeg

# 录像池与分段
RECORD_DIR=/var/lib/monitor-pro/records
DATA_DIR=/var/lib/monitor-pro/data
RECORD_POOL_MB=3072
SEGMENT_SECONDS=300

# 仪表盘“服务器根磁盘”统计的分区，默认 /（Windows 默认为当前盘符根目录）
DISK_PATH=/

# 允许的端口范围（需与前端表单区间一致）
UDP_PORT_MIN=9001
UDP_PORT_MAX=9050
HTTP_PORT_MIN=9051
HTTP_PORT_MAX=9100

# 跨域白名单；生产可设为 https://your.domain
CORS_ORIGIN=*

# 可选管理员令牌。留空表示后端不校验（默认，兼容现有前端）。
# Production requires ADMIN_TOKEN. Browser uses HttpOnly session; scripts use X-Admin-Token.
ADMIN_TOKEN=

LOG_LEVEL=info
